<body>

    <!-- Navigation -->
    <header>
        <nav>
            <div class="logo">REUBEN KIAI</div>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <p class="small-title">CREATIVE DESIGNER & WEB CREATOR</p>

            <h1>
                Turning Ideas Into
                <span>Creative Experiences.</span>
            </h1>

            <p class="hero-text">
                I create modern, engaging designs and websites
                that communicate ideas clearly and beautifully.
            </p>

            <div class="hero-buttons">
                <a href="#projects" class="btn">View My Work</a>
                <a href="#contact" class="btn secondary">Let's Talk</a>
            </div>
        </div>
    </section>

    <!-- About -->
    <section id="about" class="section">
        <div class="section-title">
            <p>GET TO KNOW ME</p>
            <h2>About Me</h2>
        </div>

        <div class="about-content">
            <div>
                <h3>Creative. Curious. Always Learning.</h3>

                <p>
                    I'm Reuben Kiai, a creative designer interested in
                    graphic design, web development and digital creativity.
                </p>

                <p>
                    I enjoy transforming ideas into visual experiences
                    that are simple, attractive and meaningful.
                </p>
            </div>

            <div class="about-box">
                <h3>My Approach</h3>
                <p>
                    Creative thinking, clean design and purposeful
                    communication.
                </p>
            </div>
        </div>
    </section>

    <!-- Services -->
    <section id="services" class="section services">
        <div class="section-title">
            <p>WHAT I DO</p>
            <h2>My Services</h2>
        </div>

        <div class="service-grid">

            <div class="service-card">
                <span>01</span>
                <h3>Graphic Design</h3>
                <p>
                    Creative posters, flyers, social media graphics
                    and promotional designs.
                </p>
            </div>

            <div class="service-card">
                <span>02</span>
                <h3>Web Design</h3>
                <p>
                    Modern and responsive websites designed for
                    individuals, organizations and businesses.
                </p>
            </div>

            <div class="service-card">
                <span>03</span>
                <h3>Branding</h3>
                <p>
                    Visual identities that help ideas and businesses
                    communicate consistently.
                </p>
            </div>

            <div class="service-card">
                <span>04</span>
                <h3>Digital Creativity</h3>
                <p>
                    Creative digital solutions that combine design,
                    technology and communication.
                </p>
            </div>

        </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="section">
        <div class="section-title">
            <p>MY WORK</p>
            <h2>Featured Projects</h2>
        </div>

        <div class="project-grid">

            <div class="project-card">
                <div class="project-placeholder">
                    PROJECT 01
                </div>

                <h3>Poster Design</h3>
                <p>Creative promotional and communication design.</p>
            </div>

            <div class="project-card">
                <div class="project-placeholder">
                    PROJECT 02
                </div>

                <h3>Event Design</h3>
                <p>Visual design created for memorable events.</p>
            </div>

            <div class="project-card">
                <div class="project-placeholder">
                    PROJECT 03
                </div>

                <h3>Web Design</h3>
                <p>Modern digital experiences built for the web.</p>
            </div>

        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact">
        <p>HAVE A PROJECT IN MIND?</p>

        <h2>Let's Create Something<br>Great Together.</h2>

        <a href="mailto:gathuareuben@gmail.com" class="btn">
            Get In Touch
        </a>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Reuben Kiai. All rights reserved.</p>
        <p>Graphic Designer & Web Creator</p>
